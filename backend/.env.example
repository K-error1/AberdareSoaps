# ==============================================================================
# Aberdares E-Commerce Backend Environment Configuration
# ==============================================================================

# Project Name (Namespacing Docker Compose to prevent collisions)
COMPOSE_PROJECT_NAME=aberdares-backend

# Django Core
# Generate a secure key in production via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-aberdares-production-ready-secret-key-change-in-prod-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Standard PostgreSQL URL)
# Local Dockerized Postgres binds to host port 5433 to avoid standard 5432 conflict.
# For running inside Docker: postgresql://aberdares_user:aberdares_password@aberdares_db:5432/aberdares_db
# For running directly on host against Docker: postgresql://aberdares_user:aberdares_password@127.0.0.1:5433/aberdares_db
DATABASE_URL=postgresql://aberdares_user:aberdares_password@127.0.0.1:5433/aberdares_db

# Host Port Bindings (Safe, conflict-free ports)
DB_HOST_PORT=5433
WEB_HOST_PORT=8001

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Cookies
# Set to True in production with HTTPS
COOKIE_SECURE=False

# M-Pesa Daraja Credentials
# Get from: https://developer.safaricom.co.ke/
# MPESA_ENV: 'sandbox' or 'production'
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Unguessable secret path segment for webhook security
MPESA_CALLBACK_SECRET=aberdares-mpesa-webhook-secret-token-xyz123
# Public host where Safaricom can send callbacks (e.g. https://api.yourdomain.com or ngrok URL for local dev)
MPESA_CALLBACK_BASE_URL=https://example.ngrok-free.app
# Comma-separated Safaricom IP ranges (leave empty in sandbox)
SAFARICOM_IP_ALLOWLIST=196.201.214.200,196.201.214.206,196.201.213.114

# Paystack Credentials
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Africa's Talking (SMS Notifications)
# Get from: https://account.africastalking.com/
# Use 'sandbox' as username for testing
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_SENDER_ID=ABERDARES

# Email Provider Configuration (Resend default, swappable)
# Get from: https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=Aberdares Soaps <orders@aberdares.co.ke>

# Loyalty Engine Settings
# 1 point earned for every KES 100 spent (configurable)
LOYALTY_EARN_RATE_KES=100
# 1 point = KES 1 redemption value
LOYALTY_POINT_VALUE_KES=1

# Order & Stock Expiry
# Minutes before unpaid pending order is auto-cancelled and stock released
ORDER_EXPIRY_MINUTES=15
